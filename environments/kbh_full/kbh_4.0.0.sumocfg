<?xml version="1.0" encoding="UTF-8"?>
<!--
    SUMO Configuration for Copenhagen scenario.
    Generated by the MSc SUMO pipeline.
    
    Adjust the route files below depending on which modes you generated.
    You can comment out modes you don't want to simulate.
-->
<configuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">

    <input>
        <net-file value="kbh_4.0.0.net.xml"/>
        <additional-files value="vtypes.xml"/>
        <!-- Add the route files you generated. Comment out modes you don't need. -->
        <route-files value="routes_car.rou.xml"/>
    </input>

    <time>
        <begin value="0"/>
        <end value="3600"/>
        <step-length value="0.5"/>
    </time>

    <processing>
        <lateral-resolution value="0.8"/>
        <ignore-route-errors value="true"/>
        <collision.action value="warn"/>
        <time-to-teleport value="300"/>
        <pedestrian.model value="striping"/>
        <pedestrian.striping.stripe-width value="0.55"/>
    </processing>

    <routing>
        <device.rerouting.probability value="0.3"/>
        <device.rerouting.period value="300"/>
    </routing>

    <report>
        <verbose value="true"/>
        <no-step-log value="false"/>
        <duration-log.statistics value="true"/>
    </report>

    <output>
        <!-- Uncomment outputs you want -->
        <!-- <tripinfo-output value="tripinfo.xml"/> -->
        <!-- <summary-output value="summary.xml"/> -->
        <!-- <emission-output value="emissions.xml"/> -->
        <!-- <fcd-output value="fcd.xml"/> -->
    </output>

    <gui_only>
        <start value="true"/>
        <quit-on-end value="false"/>
    </gui_only>

</configuration>
