# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# SUMO / T-REX run artifacts
results/
results_*/
environments/grid4x4/grid4x4/
# NOTE: environments/arterial4x4/arterial4x4/ (the zip decompressed the same way as
# grid4x4's) is intentionally NOT listed here -- unlike grid4x4's, that directory's
# ~2,800 route files are already committed to git (see AUDIT_REPORT.md Phase 1); an
# ignore pattern here wouldn't untrack them and would be misleading. Do not `rm -rf`
# environments/arterial4x4/arterial4x4/ as if it were disposable -- `git status` first.
*.tripinfo.xml
tripinfo_*.xml
metrics_*.csv
*-seed_ic1.txt
*-seed_ic2.txt
*.log

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Type checkers / test caches
.mypy_cache/
.pytest_cache/
.ruff_cache/
htmlcov/
.coverage
